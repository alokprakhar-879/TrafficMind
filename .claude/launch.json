{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "traffic-lab",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const h=require('http'),fs=require('fs'),p=require('path');const t={'.html':'text/html','.js':'text/javascript','.css':'text/css'};h.createServer((q,r)=>{const f=p.join(process.cwd(),decodeURI(q.url.split('?')[0])==='/'?'index.html':decodeURI(q.url.split('?')[0]));fs.readFile(f,(e,d)=>{if(e){r.writeHead(404);return r.end();}r.writeHead(200,{'Content-Type':t[p.extname(f)]||'text/plain'});r.end(d);});}).listen(5173,'127.0.0.1')"],
      "port": 5173
    }
  ]
}
